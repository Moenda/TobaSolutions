    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Adicionar gasto", "url": "TobaBank/TobaBank-Gastos.html?action=add_expense", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Pesagem", "url": "TobaHealth/TobaHealth-Pesagem.html", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Treinos", "url": "TobaHealth/TobaHealth-Treinos.html", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Rotina de hoje", "url": "TobaRoutine/TobaRoutine-Rotina.html", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
